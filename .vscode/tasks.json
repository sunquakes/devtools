{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CodeGraph: Initialize",
            "type": "shell",
            "command": "trae",
            "args": [
                "codegraph",
                "init"
            ],
            "cwd": "${workspaceFolder}",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "CodeGraph: Update",
            "type": "shell",
            "command": "trae",
            "args": [
                "codegraph",
                "update"
            ],
            "cwd": "${workspaceFolder}",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "CodeGraph: Clean",
            "type": "shell",
            "command": "trae",
            "args": [
                "codegraph",
                "clean"
            ],
            "cwd": "${workspaceFolder}",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "--configuration",
                "Release"
            ],
            "cwd": "${workspaceFolder}",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build (Debug)",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "--configuration",
                "Debug"
            ],
            "cwd": "${workspaceFolder}",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "clean"
            ],
            "cwd": "${workspaceFolder}",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Restore",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "restore"
            ],
            "cwd": "${workspaceFolder}",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Rebuild",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "--configuration",
                "Release",
                "--clean"
            ],
            "cwd": "${workspaceFolder}",
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$msCompile"
        }
    ]
}