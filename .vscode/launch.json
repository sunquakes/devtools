{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (WPF)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/bin/Debug/net8.0-windows10.0.26100.0/DevTools.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "justMyCode": true,
            "preLaunchTask": "Build (Debug)",
            "symbolOptions": {
                "searchPaths": [],
                "moduleFilter": {
                    "mode": "exclude",
                    "patterns": [
                        "Microsoft.*",
                        "System.*"
                    ]
                },
                "suppressMissingSourceFilesWarning": true
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": ".NET Core Launch (Release)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/bin/Release/net8.0-windows10.0.26100.0/DevTools.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "justMyCode": true,
            "preLaunchTask": "Build",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Production"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}