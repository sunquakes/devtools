<Page x:Class="DevTools.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:DevTools.Pages"
      xmlns:resources="clr-namespace:DevTools.Resources"
      Title="HomePage">
    <Page.Resources>
        <!-- TabItem style -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" 
                                Background="Transparent" 
                                CornerRadius="8,8,0,0" 
                                Padding="16,10"
                                Margin="4,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="icon" 
                                           FontFamily="{StaticResource FontAwesomeSolid}" 
                                           Text="{TemplateBinding Tag}" 
                                           FontSize="14" 
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="#888888"/>
                                <TextBlock x:Name="text" 
                                           Text="{TemplateBinding Header}" 
                                           FontSize="14" 
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="#555555"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Selected state (highest priority) -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="icon" Property="Foreground" Value="#333333"/>
                                <Setter TargetName="text" Property="Foreground" Value="#333333"/>
                            </Trigger>
                            <!-- Hover state (only when not selected) -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#E8E8E8"/>
                                <Setter TargetName="icon" Property="Foreground" Value="#555555"/>
                                <Setter TargetName="text" Property="Foreground" Value="#333333"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabPanel style for horizontal tabs -->
        <Style x:Key="ModernTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="#F5F5F5" CornerRadius="8,8,0,0" Grid.Row="0" Margin="0,0,0,0">
                                <TabPanel IsItemsHost="True" Margin="8,4,8,0"/>
                            </Border>
                            <Border Background="#FFFFFF" CornerRadius="0,0,8,8" Grid.Row="1" Padding="16" BorderBrush="#E0E0E0" BorderThickness="1">
                                <ContentPresenter ContentSource="SelectedContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tool button style -->
        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource CardButtonStyle}">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="130"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Background" Value="#6B7280"/>
        </Style>

        <!-- Search box style -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0,40,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="CaretBrush" Value="#666666"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="20">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" 
                                              Margin="{TemplateBinding Padding}" 
                                              VerticalAlignment="Center"/>
                                <TextBlock Text="&#xf002;" 
                                           FontFamily="{StaticResource FontAwesomeSolid}" 
                                           FontSize="16" 
                                           Foreground="#888888" 
                                           HorizontalAlignment="Right" 
                                           VerticalAlignment="Center" 
                                           Margin="0,0,16,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Settings button -->
        <Button x:Name="BtnSettings" 
                Click="BtnSettings_Click" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Margin="0,10,10,0" 
                Width="40" 
                Height="40"
                ToolTip="{x:Static resources:Strings.PageSettings}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#4A4A4A" CornerRadius="20" Width="40" Height="40" SnapsToDevicePixels="True">
                        <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" Text="&#xf013;" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
        
        <!-- Search box -->
        <TextBox x:Name="SearchBox" 
                 Style="{StaticResource SearchBoxStyle}"
                 HorizontalAlignment="Left" 
                 VerticalAlignment="Top" 
                 Margin="20,10,0,0"
                 TextChanged="SearchBox_TextChanged"
                 KeyDown="SearchBox_KeyDown"
                 IsUndoEnabled="True"
                 UndoLimit="20"/>
        
        <TabControl Style="{StaticResource ModernTabControl}" 
                    Margin="20,60,20,20">
            
            <!-- 编码工具 -->
            <TabItem Header="{x:Static resources:Strings.CategoryEncoding}" Tag="&#xf121;" Style="{StaticResource ModernTabItem}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid Width="Auto">
                        <WrapPanel HorizontalAlignment="Left" Margin="10" Orientation="Horizontal">
                            <Button x:Name="BtnMd5" Click="BtnMd5_Click" Style="{StaticResource ToolButtonStyle}" Tag="MD5">
                                <StackPanel Width="140" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" Text="&#xf023;" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#FFFFFF" />
                                    <TextBlock Text="{x:Static resources:Strings.MD5}" FontSize="15" HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="#FFFFFF" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnUrlEncode" Click="BtnUrlEncode_Click" Style="{StaticResource ToolButtonStyle}" Tag="URL Encode Decode 编码 解码">
                                <StackPanel Width="140" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" Text="&#xf0c1;" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#FFFFFF" />
                                    <TextBlock Text="{x:Static resources:Strings.PageUrlEncode}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFFFFF" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnEscape" Click="BtnEscape_Click" Style="{StaticResource ToolButtonStyle}" Tag="Escape String Escape 转义">
                                <StackPanel Width="140" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" Text="&#xf121;" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#FFFFFF" />
                                    <TextBlock Text="{x:Static resources:Strings.PageEscape}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFFFFF" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnRandomString" Click="BtnRandomString_Click" Style="{StaticResource ToolButtonStyle}" Tag="Random String Generator 随机字符串">
                                <StackPanel Width="140" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" Text="&#xf074;" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#FFFFFF" />
                                    <TextBlock Text="{x:Static resources:Strings.PageRandomString}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFFFFF" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 图片工具 -->
            <TabItem Header="{x:Static resources:Strings.CategoryImage}" Tag="&#xf03e;" Style="{StaticResource ModernTabItem}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid Width="Auto">
                        <WrapPanel HorizontalAlignment="Left" Margin="10" Orientation="Horizontal">
                            <Button x:Name="BtnQr" Click="BtnQr_Click" Style="{StaticResource ToolButtonStyle}" Tag="QR Code 二维码">
                                <StackPanel Width="140" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" Text="&#xf029;" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#FFFFFF" />
                                    <TextBlock Text="{x:Static resources:Strings.QRCode}" FontSize="15" HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="#FFFFFF" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnBarcode" Click="BtnBarcode_Click" Style="{StaticResource ToolButtonStyle}" Tag="Barcode 条形码">
                                <StackPanel Width="140" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" Text="&#xf02a;" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#FFFFFF" />
                                    <TextBlock Text="{x:Static resources:Strings.Barcode}" FontSize="15" HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="#FFFFFF" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnBase64ToImage" Click="BtnBase64ToImage_Click" Style="{StaticResource ToolButtonStyle}" Tag="Base64 to Image Base64转图片">
                                <StackPanel Width="140" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" Text="&#xf03e;" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#FFFFFF" />
                                    <TextBlock Text="{x:Static resources:Strings.Base64ToImage}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFFFFF" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnImageToBase64" Click="BtnImageToBase64_Click" Style="{StaticResource ToolButtonStyle}" Tag="Image to Base64 图片转Base64">
                                <StackPanel Width="140" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" Text="&#xf093;" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#FFFFFF" />
                                    <TextBlock Text="{x:Static resources:Strings.ImageToBase64}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFFFFF" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnSignature" Click="BtnSignature_Click" Style="{StaticResource ToolButtonStyle}" Tag="Handwritten Signature 手写签名">
                                <StackPanel Width="140" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" Text="&#xf5b7;" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#FFFFFF" />
                                    <TextBlock Text="{x:Static resources:Strings.PageSignature}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFFFFF" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnQrBarcodeDecode" Click="BtnQrBarcodeDecode_Click" Style="{StaticResource ToolButtonStyle}" Tag="QR Barcode Decoder 二维码识别 条形码识别">
                                <StackPanel Width="140" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" Text="&#xf083;" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#FFFFFF" />
                                    <TextBlock Text="{x:Static resources:Strings.PageQrBarcodeDecode}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFFFFF" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 数据处理 -->
            <TabItem Header="{x:Static resources:Strings.CategoryData}" Tag="&#xf1c0;" Style="{StaticResource ModernTabItem}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid Width="Auto">
                        <WrapPanel HorizontalAlignment="Left" Margin="10" Orientation="Horizontal">
                            <Button x:Name="BtnJsonFormat" Click="BtnJsonFormat_Click" Style="{StaticResource ToolButtonStyle}" Tag="JSON Format 格式化">
                                <StackPanel Width="140" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" Text="&#xf1c9;" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#FFFFFF" />
                                    <TextBlock Text="{x:Static resources:Strings.JSONFormat}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFFFFF" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 查询工具 -->
            <TabItem Header="{x:Static resources:Strings.CategoryQuery}" Tag="&#xf002;" Style="{StaticResource ModernTabItem}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid Width="Auto">
                        <WrapPanel HorizontalAlignment="Left" Margin="10" Orientation="Horizontal">
                            <Button x:Name="BtnDistrictCode" Click="BtnDistrictCode_Click" Style="{StaticResource ToolButtonStyle}" Tag="District Code Query 行政编码查询">
                                <StackPanel Width="140" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" Text="&#xf3c5;" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#FFFFFF" />
                                    <TextBlock Text="{x:Static resources:Strings.PageDistrictCode}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFFFFF" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>