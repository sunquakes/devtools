<Page x:Class="DevTools.Pages.RandomStringPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:resources="clr-namespace:DevTools.Resources"
      Title="RandomStringPage">
    <Grid Margin="20">
        <StackPanel>
            <Button Click="Back_Click" HorizontalAlignment="Left" Margin="0,0,0,8" Width="40" Height="40" ToolTip="{x:Static resources:Strings.Back}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#4A4A4A" CornerRadius="20" Width="40" Height="40" SnapsToDevicePixels="True">
                            <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" Text="&#xf060;" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock Text="{x:Static resources:Strings.PageRandomString}" FontSize="18" Margin="0,10" />

            <StackPanel Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="{x:Static resources:Strings.Count}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="CountText" Width="80" Height="32" Text="1" VerticalContentAlignment="Center" Margin="0,0,20,0" />

                <TextBlock Text="{x:Static resources:Strings.Length}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="LengthText" Width="80" Height="32" Text="8" VerticalContentAlignment="Center" Margin="0,0,20,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10">
                <CheckBox x:Name="LowercaseCheck" Content="{x:Static resources:Strings.LowercaseLetters}" FontSize="14" Margin="0,0,20,0" IsChecked="True" />
                <CheckBox x:Name="UppercaseCheck" Content="{x:Static resources:Strings.UppercaseLetters}" FontSize="14" Margin="0,0,20,0" IsChecked="True" />
                <CheckBox x:Name="NumbersCheck" Content="{x:Static resources:Strings.Numbers}" FontSize="14" Margin="0,0,20,0" IsChecked="True" />
                <CheckBox x:Name="SpecialCheck" Content="{x:Static resources:Strings.SpecialCharacters}" FontSize="14" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,15">
                <Button Click="Generate_Click" Width="40" Height="40" Margin="0,0,10,0" ToolTip="{x:Static resources:Strings.Generate}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#4A4A4A" CornerRadius="20" Width="40" Height="40" SnapsToDevicePixels="True">
                                <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" Text="&#xf074;" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Click="CopyResult_Click" Width="40" Height="40" Margin="0,0,10,0" ToolTip="{x:Static resources:Strings.Copy}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#4A4A4A" CornerRadius="20" Width="40" Height="40" SnapsToDevicePixels="True">
                                <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" Text="&#xf0c5;" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Click="Clear_Click" Width="40" Height="40" ToolTip="{x:Static resources:Strings.Clear}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#4A4A4A" CornerRadius="20" Width="40" Height="40" SnapsToDevicePixels="True">
                                <TextBlock FontFamily="{StaticResource FontAwesomeSolid}" Text="&#xf2ed;" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <TextBlock Text="{x:Static resources:Strings.Result}" FontSize="16" FontWeight="Bold" Margin="0,10,0,5" />
            <TextBox x:Name="ResultText" Height="200" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto" />
        </StackPanel>
    </Grid>
</Page>
